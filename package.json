{
  "name": "mini-adjudication",
  "version": "5.2.0",
  "description": "Post-audit vulnerability acceptance standard and CNVD packaging pipeline: judge whether audited findings hold (/adjudicate) and package accepted findings into 3-section Word reports (报告.docx), PoC.md/PoC.sh, screenshots, and zero-overlay narrated videos (/cnvd-pack).",
  "bin": {
    "mini-adjudication": "bin/cli.js"
  },
  "files": [
    "bin",
    "cli",
    "skills",
    "SKILL.md",
    "README.md",
    "references",
    "templates",
    "schemas",
    "runtime/*.py",
    "runtime/*.json",
    "fixtures",
    "_meta.json"
  ],
  "keywords": [
    "security",
    "audit",
    "vulnerability",
    "triage",
    "adjudication",
    "cvss",
    "cve",
    "cnvd",
    "src",
    "agent-skill",
    "zcode",
    "claude"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rinne666/mini-adjudication.git"
  },
  "scripts": {
    "test": "node bin/test.js",
    "test:cli": "node --test tests/cli.test.js",
    "test:package": "node tests/smoke-package.js",
    "prepack": "node bin/cli.js run check_skill_loaded.py",
    "doctor": "node bin/cli.js doctor"
  }
}
